# AI Health Document Assistant - Local Environment Settings
# Duplicate this file as '.env' and populate your local variables.

# Core Configuration
PROJECT_NAME="AI Health Document Assistant"

# Database Connection
# Adjust if running outside Docker (e.g. localhost)
DATABASE_URL="postgresql://postgres:postgrespassword123@localhost:5432/health_assistant"

# JSON Web Token Cryptography
# Generate a secure random hex key: openssl rand -hex 32
SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY_HERE"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI/LLM Provider settings
# Keep empty to run in mock fallback mode
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
